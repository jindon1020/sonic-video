[Unit]
Description=SonicVideo AI Video Editing Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sonicvideo
Environment="PATH=/opt/sonicvideo/venv/bin"
Environment="USE_LANGGRAPH=true"
ExecStart=/opt/sonicvideo/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=10

# 日志配置
StandardOutput=append:/var/log/sonicvideo/sonicvideo.log
StandardError=append:/var/log/sonicvideo/error.log

# 安全配置
NoNewPrivileges=true
PrivateTmp=true

# 资源限制
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
